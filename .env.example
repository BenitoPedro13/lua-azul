# Copy to `.env` at the REPO ROOT: cp .env.example .env
#
# ─── Discord ────────────────────────────────────────────────
# From the Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register slash commands INSTANTLY to one test guild during dev.
# (Global commands take up to ~1h to propagate.) Leave empty in production.
DISCORD_DEV_GUILD_ID=

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Database (matches docker-compose) ──────────────────────
DATABASE_URL=postgresql://lua:lua@localhost:5432/lua_azul?schema=public

# ─── Lavalink (matches docker-compose) ──────────────────────
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ─── Features ───────────────────────────────────────────────
# Enable the audit-logging module. Requires the Server Members + Message Content
# privileged intents to be ON in the Developer Portal. Leave false for music-only.
LOGGING_ENABLED=false

# ─── Music providers ────────────────────────────────────────
# Consumed by Lavalink's LavaSrc plugin (see infra/lavalink/application.yml),
# NOT by the bot process directly.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
